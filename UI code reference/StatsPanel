import { TrendingUp, Target, CheckCircle2, Clock } from "lucide-react";
import { CATEGORY_COLORS, type Task, type TaskCategory } from "./types";
import { cn } from "@/lib/utils";

interface Props {
  tasks: Task[];
  monthlyGoal: number;
}

export function StatsPanel({ tasks, monthlyGoal }: Props) {
  const earnings = tasks.filter((t) => t.completed).reduce((s, t) => s + t.value, 0);
  const pending = tasks.filter((t) => !t.completed).reduce((s, t) => s + t.value, 0);
  const progress = Math.min(100, Math.round((earnings / monthlyGoal) * 100));

  const byCategory = tasks.reduce<Record<string, { total: number; done: number }>>((acc, t) => {
    if (!acc[t.category]) acc[t.category] = { total: 0, done: 0 };
    acc[t.category].total += t.value;
    if (t.completed) acc[t.category].done += t.value;
    return acc;
  }, {});

  // Circular progress
  const radius = 70;
  const circumference = 2 * Math.PI * radius;
  const dash = (progress / 100) * circumference;

  return (
    <aside className="space-y-5">
      {/* Goal card with circular progress */}
      <div className="glass-strong rounded-3xl p-6 relative overflow-hidden">
        {/* Glow background */}
        <div className="absolute -top-20 -right-20 h-48 w-48 rounded-full bg-primary/20 blur-3xl pointer-events-none" />

        <div className="relative">
          <div className="flex items-center gap-2 text-muted-foreground text-[11px] font-medium uppercase tracking-[0.18em]">
            <Target className="h-3.5 w-3.5" />
            Monthly Goal
          </div>

          <div className="mt-5 flex items-center justify-center">
            <div className="relative h-44 w-44">
              <svg className="h-full w-full -rotate-90" viewBox="0 0 160 160">
                <defs>
                  <linearGradient id="progGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stopColor="hsl(199 95% 70%)" />
                    <stop offset="100%" stopColor="hsl(220 90% 60%)" />
                  </linearGradient>
                </defs>
                <circle
                  cx="80"
                  cy="80"
                  r={radius}
                  stroke="hsl(220 25% 22%)"
                  strokeWidth="10"
                  fill="none"
                />
                <circle
                  cx="80"
                  cy="80"
                  r={radius}
                  stroke="url(#progGrad)"
                  strokeWidth="10"
                  strokeLinecap="round"
                  fill="none"
                  strokeDasharray={`${dash} ${circumference}`}
                  style={{
                    filter: "drop-shadow(0 0 8px hsl(199 95% 65% / 0.6))",
                    transition: "stroke-dasharray 0.6s ease",
                  }}
                />
              </svg>
              <div className="absolute inset-0 flex flex-col items-center justify-center">
                <span className="text-3xl font-bold text-foreground tracking-tight">
                  {progress}%
                </span>
                <span className="text-[10px] uppercase tracking-[0.15em] text-muted-foreground mt-1">
                  Goal Reached
                </span>
              </div>
            </div>
          </div>

          <div className="mt-5 text-center">
            <p className="text-xs text-muted-foreground">Target value</p>
            <p className="text-2xl font-bold text-foreground tracking-tight">
              ${monthlyGoal.toLocaleString()}
            </p>
          </div>

          <div className="mt-5 grid grid-cols-2 gap-2 pt-4 border-t border-border/40">
            <div className="rounded-2xl bg-muted/30 p-3">
              <div className="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wider">
                <CheckCircle2 className="h-3 w-3 text-success" />
                Earnings
              </div>
              <p className="mt-1 text-base font-semibold text-foreground">
                ${(earnings / 1000).toFixed(1)}k
              </p>
            </div>
            <div className="rounded-2xl bg-muted/30 p-3">
              <div className="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wider">
                <Clock className="h-3 w-3 text-warning" />
                Pending
              </div>
              <p className="mt-1 text-base font-semibold text-foreground">
                ${(pending / 1000).toFixed(1)}k
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Category breakdown */}
      <div className="glass-strong rounded-3xl p-6">
        <div className="flex items-center justify-between mb-5">
          <div>
            <p className="text-[11px] uppercase tracking-[0.18em] text-muted-foreground">
              Breakdown
            </p>
            <h3 className="font-semibold text-foreground mt-0.5">By Category</h3>
          </div>
          <div className="h-9 w-9 rounded-full bg-muted/40 flex items-center justify-center">
            <TrendingUp className="h-4 w-4 text-primary" />
          </div>
        </div>

        <div className="space-y-4">
          {Object.entries(byCategory).map(([cat, { total, done }]) => {
            const pct = total ? Math.round((done / total) * 100) : 0;
            return (
              <div key={cat}>
                <div className="flex items-center justify-between text-sm mb-2">
                  <span
                    className={cn(
                      "px-2.5 py-0.5 rounded-full text-[11px] font-medium border",
                      CATEGORY_COLORS[cat as TaskCategory]
                    )}
                  >
                    {cat}
                  </span>
                  <span className="text-[11px] text-muted-foreground tabular-nums">
                    ${(done / 1000).toFixed(1)}k <span className="opacity-50">/ ${(total / 1000).toFixed(1)}k</span>
                  </span>
                </div>
                <div className="h-1.5 rounded-full bg-muted/40 overflow-hidden">
                  <div
                    className="h-full rounded-full bg-gradient-to-r from-primary to-[hsl(220_90%_60%)] shadow-[0_0_8px_hsl(199_95%_65%/0.5)] transition-all duration-700"
                    style={{ width: `${pct}%` }}
                  />
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </aside>
  );
}
