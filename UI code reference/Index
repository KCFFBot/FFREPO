@tailwind base;
@tailwind components;
@tailwind utilities;

/* Glassmorphic dark dashboard — deep navy, soft glows, frosted surfaces */

@layer base {
  :root {
    /* Deep navy base */
    --background: 222 38% 8%;
    --foreground: 210 30% 92%;

    --card: 222 32% 12%;
    --card-foreground: 210 30% 94%;

    --popover: 222 32% 11%;
    --popover-foreground: 210 30% 94%;

    --primary: 199 95% 65%;
    --primary-foreground: 222 47% 8%;

    --secondary: 222 25% 18%;
    --secondary-foreground: 210 30% 92%;

    --muted: 222 22% 16%;
    --muted-foreground: 215 18% 62%;

    --accent: 199 90% 60%;
    --accent-foreground: 222 47% 8%;

    --destructive: 0 72% 60%;
    --destructive-foreground: 0 0% 100%;

    --success: 158 70% 55%;
    --success-foreground: 222 47% 8%;

    --warning: 38 95% 62%;
    --warning-foreground: 222 47% 8%;

    --border: 220 25% 22%;
    --input: 220 25% 22%;
    --ring: 199 95% 65%;

    --radius: 1.25rem;

    /* Glass sidebar */
    --sidebar-background: 222 40% 7%;
    --sidebar-foreground: 215 20% 70%;
    --sidebar-primary: 199 95% 65%;
    --sidebar-primary-foreground: 222 47% 8%;
    --sidebar-accent: 220 30% 16%;
    --sidebar-accent-foreground: 0 0% 100%;
    --sidebar-border: 220 25% 16%;
    --sidebar-ring: 199 95% 65%;

    /* Signature gradients & glows */
    --gradient-app: radial-gradient(ellipse at top left, hsl(220 50% 18% / 0.9), transparent 50%),
                    radial-gradient(ellipse at bottom right, hsl(199 70% 25% / 0.5), transparent 60%),
                    linear-gradient(180deg, hsl(222 40% 8%), hsl(222 45% 5%));
    --gradient-glass: linear-gradient(135deg, hsl(220 30% 18% / 0.55), hsl(220 30% 12% / 0.35));
    --gradient-glow: radial-gradient(circle at 50% 50%, hsl(199 95% 65% / 0.55), transparent 70%);
    --gradient-primary: linear-gradient(135deg, hsl(199 95% 70%), hsl(220 90% 60%));
    --gradient-amber: linear-gradient(135deg, hsl(38 95% 65%), hsl(20 90% 55%));
    --gradient-success: linear-gradient(135deg, hsl(158 70% 55%), hsl(180 70% 50%));

    --shadow-glass: 0 8px 32px 0 hsl(222 60% 3% / 0.5),
                    inset 0 1px 0 0 hsl(210 30% 100% / 0.06);
    --shadow-glow-primary: 0 0 40px hsl(199 95% 65% / 0.35);
    --shadow-glow-soft: 0 10px 40px -10px hsl(199 95% 65% / 0.25);

    --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .dark {
    /* Same — site is dark by default */
    --background: 222 38% 8%;
    --foreground: 210 30% 92%;
    --card: 222 32% 12%;
    --card-foreground: 210 30% 94%;
    --popover: 222 32% 11%;
    --popover-foreground: 210 30% 94%;
    --primary: 199 95% 65%;
    --primary-foreground: 222 47% 8%;
    --secondary: 222 25% 18%;
    --secondary-foreground: 210 30% 92%;
    --muted: 222 22% 16%;
    --muted-foreground: 215 18% 62%;
    --accent: 199 90% 60%;
    --accent-foreground: 222 47% 8%;
    --border: 220 25% 22%;
    --input: 220 25% 22%;
    --ring: 199 95% 65%;
  }
}

@layer base {
  * {
    @apply border-border;
  }
  html, body, #root {
    @apply min-h-screen;
  }
  body {
    @apply text-foreground antialiased;
    background: var(--gradient-app);
    background-attachment: fixed;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11", "ss01";
    letter-spacing: -0.01em;
  }
}

@layer utilities {
  .glass {
    background: var(--gradient-glass);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
    border: 1px solid hsl(210 30% 100% / 0.08);
    box-shadow: var(--shadow-glass);
  }
  .glass-strong {
    background: linear-gradient(135deg, hsl(220 30% 22% / 0.7), hsl(220 30% 14% / 0.5));
    backdrop-filter: blur(32px) saturate(160%);
    -webkit-backdrop-filter: blur(32px) saturate(160%);
    border: 1px solid hsl(210 30% 100% / 0.1);
    box-shadow: var(--shadow-glass);
  }
  .glow-primary {
    box-shadow: var(--shadow-glow-primary);
  }
  .text-glow {
    text-shadow: 0 0 24px hsl(199 95% 65% / 0.5);
  }
}
